define timeperiod {
    timeperiod_name    pve-lma-24x7
    alias              24 Hours A Day, 7 Days A Week
    sunday             00:00-24:00
    monday             00:00-24:00
    tuesday            00:00-24:00
    wednesday          00:00-24:00
    thursday           00:00-24:00
    friday             00:00-24:00
    saturday           00:00-24:00
}

define command {
    command_name    pve-lma-check-ping
    command_line    /usr/lib/nagios/plugins/check_ping -H $HOSTADDRESS$ -w 3000.0,80% -c 5000.0,100% -p 5
}

define command {
    command_name    pve-lma-check-ssh
    command_line    /usr/lib/nagios/plugins/check_ssh -H $HOSTADDRESS$ -t 10
}

define command {
    command_name    pve-lma-check-tcp
    command_line    /usr/lib/nagios/plugins/check_tcp -H $HOSTADDRESS$ -p $ARG1$ -t 10
}

define command {
    command_name    pve-lma-noop
    command_line    /bin/true
}

define contact {
    contact_name                    pve-lma-null
    alias                           Null contact (no notification transport)
    service_notification_period     pve-lma-24x7
    host_notification_period        pve-lma-24x7
    service_notification_options    w,u,c,r
    host_notification_options       d,u,r
    service_notification_commands   pve-lma-noop
    host_notification_commands      pve-lma-noop
}

define contactgroup {
    contactgroup_name   pve-obs-lma-hub
    alias               PVE LMA hub (no transport)
    members             pve-lma-null
}

define host {
    name                            pve-lma-host
    check_command                   pve-lma-check-ping
    max_check_attempts              3
    check_interval                  5
    retry_interval                  1
    check_period                    pve-lma-24x7
    notification_interval           60
    notification_period             pve-lma-24x7
    notification_options            d,u,r
    contact_groups                  pve-obs-lma-hub
    notifications_enabled           1
    register                        0
}

define service {
    name                            pve-lma-service
    max_check_attempts              3
    check_interval                  5
    retry_interval                  1
    check_period                    pve-lma-24x7
    notification_interval           60
    notification_period             pve-lma-24x7
    notification_options            w,u,c,r
    contact_groups                  pve-obs-lma-hub
    notifications_enabled           1
    register                        0
}

define host {
    use             pve-lma-host
    host_name       pve-lma-nagios
    alias           Nagios hub machine (obs-lma-nagios, CT {{ pve_lma_nagios_vmid }})
    address         {{ pve_lma_nagios_ip }}
}

define service {
    use                     pve-lma-service
    host_name               pve-lma-nagios
    service_description     SSH
    check_command           pve-lma-check-ssh
}

define service {
    use                     pve-lma-service
    host_name               pve-lma-nagios
    service_description     Nagios HTTP 80
    check_command           pve-lma-check-tcp!80
}

define host {
    use             pve-lma-host
    host_name       pve-lma-ctrl
    alias           Juju 2.9 controller machine (obs-lma-ctrl, CT {{ pve_lma_controller_vmid }})
    address         {{ pve_lma_controller_ip }}
}

define service {
    use                     pve-lma-service
    host_name               pve-lma-ctrl
    service_description     SSH
    check_command           pve-lma-check-ssh
}

define service {
    use                     pve-lma-service
    host_name               pve-lma-ctrl
    service_description     Juju API 17070
    check_command           pve-lma-check-tcp!17070
}
