[Unit]
Description=Setup loopback device for iSCSI {{ iscsi_vg_name }} VG
DefaultDependencies=no
After=local-fs.target
Before=lvm2-activation.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'DEV=$(losetup --find --show {{ iscsi_storage_file }}) && vgchange -ay {{ iscsi_vg_name }}'
ExecStop=/bin/bash -c 'vgchange -an {{ iscsi_vg_name }}; losetup -d $(losetup -j {{ iscsi_storage_file }} -O NAME --noheadings)'

[Install]
WantedBy=multi-user.target
