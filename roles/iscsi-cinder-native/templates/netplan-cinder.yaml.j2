network:
  version: 2
  ethernets:
    eth0:
      addresses: [{{ iscsi_cinder_eth0_ip }}/24]
      routes:
        - to: default
          via: {{ iscsi_cinder_gateway }}
          metric: 100
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
      dhcp4: false
    eth1:
      addresses: [{{ iscsi_cinder_eth1_ip }}/24]
      routes:
        - to: 192.168.165.0/24
          via: 192.168.165.1
          metric: 200
      dhcp4: false
    eth2:
      addresses: [{{ iscsi_cinder_eth2_ip }}/24]
      dhcp4: false
