[DEFAULT]
rootwrap_config = /etc/cinder/rootwrap.conf
api_paste_confg = /etc/cinder/api-paste.ini
iscsi_helper = tgtadm
verbose = False
debug = True
auth_strategy = keystone
state_path = /var/lib/cinder
transport_url = rabbit://cinder:{{ iscsi_rabbit_password }}@{{ iscsi_rabbitmq_host }}:5672/openstack
enabled_backends = lvm-iscsi
host = {{ iscsi_cinder_host }}
my_ip = {{ iscsi_portal_ip_1 }}
glance_api_servers = {{ iscsi_glance_api }}

[database]
connection = mysql+pymysql://cinder:{{ iscsi_mysql_password }}@{{ iscsi_mysql_host }}/cinder

[keystone_authtoken]
auth_type = password
auth_uri = {{ iscsi_keystone_url }}
auth_url = {{ iscsi_keystone_admin_url }}
project_domain_name = service_domain
user_domain_name = service_domain
service_type = volumev3
project_name = services
username = {{ iscsi_cinder_username }}
password = {{ iscsi_cinder_password }}
service_token_roles = Admin
service_token_roles_required = True

[service_user]
send_service_user_token = true
auth_type = password
auth_url = {{ iscsi_keystone_admin_url }}
project_domain_name = service_domain
user_domain_name = service_domain
project_name = services
username = {{ iscsi_cinder_username }}
password = {{ iscsi_cinder_password }}

[oslo_messaging_notifications]
driver = messagingv2
transport_url = rabbit://cinder:{{ iscsi_rabbit_password }}@{{ iscsi_rabbitmq_host }}:5672/openstack

[lvm-iscsi]
volume_driver = cinder.volume.drivers.lvm.LVMVolumeDriver
volume_group = {{ iscsi_vg_name }}
target_protocol = iscsi
target_helper = tgtadm
volume_backend_name = {{ iscsi_volume_backend_name }}
iscsi_ip_address = {{ iscsi_portal_ip_1 }}
iscsi_secondary_ip_addresses = {{ iscsi_portal_ip_2 }}
lvm_type = default
