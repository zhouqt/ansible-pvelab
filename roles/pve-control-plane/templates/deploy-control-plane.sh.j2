#!/bin/bash
set -euo pipefail
export HOME=/home/ubuntu PATH=/snap/bin:/usr/bin:/bin J=/snap/bin/juju

j() {
  if [ "${1:-}" = add-relation ]; then
    local output
    if output=$(/snap/bin/juju "$@" 2>&1); then
      printf 'REL %s\n' "$output"
    elif grep -qiE 'relation.*already exists' <<<"$output"; then
      printf 'REL already exists\n'
    else
      printf '%s\n' "$output" >&2
      return 1
    fi
  else
    /snap/bin/juju "$@"
  fi
}
application_exists() {
  local application=$1 output rc
  if ! output=$(j status -m openstack --format json); then
    printf 'ERROR: failed to read OpenStack application inventory\n' >&2
    exit 1
  fi
  if python3 -c '
import json, sys
try:
    status = json.load(sys.stdin)
except Exception as error:
    print(f"ERROR: invalid Juju status JSON: {error}", file=sys.stderr)
    raise SystemExit(2)
applications = status.get("applications") if isinstance(status, dict) else None
if not isinstance(applications, dict):
    print("ERROR: Juju status JSON has no applications object", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(0 if sys.argv[1] in applications else 1)
' "$application" <<<"$output"; then
    return 0
  else
    rc=$?
    [[ "$rc" == 1 ]] && return 1
    exit "$rc"
  fi
}
if application_exists dashboard-mysql-router; then
  echo "SKIP dashboard-mysql-router"
else
  echo "DEPLOY dashboard-mysql-router"
  j deploy mysql-router dashboard-mysql-router --series focal --channel 8.0/stable --revision 257 --bind internal -m openstack 2>&1 | tail -1
fi
if application_exists glance; then
  echo "SKIP glance"
else
  echo "DEPLOY glance"
  j deploy glance glance --series focal --channel ussuri/stable --revision 589 --num-units 1 --to 12 --bind 'internal public=alpha admin=internal' -m openstack 2>&1 | tail -1
fi
if application_exists glance-mysql-router; then
  echo "SKIP glance-mysql-router"
else
  echo "DEPLOY glance-mysql-router"
  j deploy mysql-router glance-mysql-router --series focal --channel 8.0/stable --revision 257 --bind internal -m openstack 2>&1 | tail -1
fi
