#!/bin/bash
{%- set apps = pve_ussuri_deploy_apps | default(pve_ussuri_control_plane_apps) %}
{%- set rels = pve_ussuri_deploy_relations | default(pve_ussuri_control_plane_relations) %}
{%- set settle = pve_ussuri_deploy_settle_seconds | default(pve_ussuri_control_plane_settle_seconds) %}

set -euo pipefail
export HOME=/home/ubuntu PATH=/snap/bin:/usr/bin:/bin

{%- set rel_attempts = pve_ussuri_deploy_rel_attempts | default(pve_ussuri_control_plane_rel_attempts) %}
{%- set rel_delay = pve_ussuri_deploy_rel_delay | default(pve_ussuri_control_plane_rel_delay) %}

MODEL='{{ pve_juju_controller_name }}:{{ pve_ussuri_model_name }}'
JUJU=/snap/bin/juju
REL_ATTEMPTS={{ rel_attempts }}
REL_DELAY={{ rel_delay }}

j() {
  if [ "${1:-}" = add-relation ]; then
    local output attempt
    for attempt in $(seq 1 "$REL_ATTEMPTS"); do
      if output=$("$JUJU" "$@" 2>&1); then
        printf 'REL %s\n' "$output"
        return 0
      fi
      if grep -qiE '\(already exists\)|relation already exists' <<<"$output"; then
        printf 'REL already exists\n'
        return 0
      fi
      printf 'REL-RETRY %d/%d: %s\n' "$attempt" "$REL_ATTEMPTS" "$output" >&2
      sleep "$REL_DELAY"
    done
    printf 'REL-FAILED: %s\n' "$output" >&2
    return 1
  fi
  "$JUJU" "$@"
}

STATUS_JSON=$("$JUJU" status -m "$MODEL" --format json)
app_exists() {
  python3 -c 'import json,sys
d = json.load(sys.stdin)
apps = d.get("applications") if isinstance(d, dict) else None
raise SystemExit(0 if isinstance(apps, dict) and sys.argv[1] in apps else 1)' "$1" <<<"$STATUS_JSON"
}

placement_state() {
  python3 -c 'import json,sys
app = sys.argv[1]
want = sorted(x for x in sys.argv[2].split(",") if x)
appinfo = (json.load(sys.stdin).get("applications") or {}).get(app) or {}
units = appinfo.get("units") or {}
got = sorted({str(u.get("machine")) for u in units.values() if u.get("machine")})
if not got:
    print("ABSENT")
elif got == want:
    print("OK")
else:
    print("MOVE " + ",".join(got))' "$1" "$2" <<<"$STATUS_JSON"
}

{% for a in apps %}
{%- set to = (pve_ussuri_unit_machines[a.app] | default({}) | dictsort | map('last') | join(',')) %}
{%- if to %}
if app_exists {{ a.app }}; then
  st=$(placement_state {{ a.app }} '{{ to }}')
  case "$st" in
    MOVE*)
{% if a.movable | default(false) %}
      echo "MOVE-REMOVE {{ a.app }} (currently ${st#MOVE }, the topology wants {{ to }})"
      "$JUJU" remove-application --force --no-prompt -m "$MODEL" {{ a.app }} 2>&1 | tail -3
      for i in $(seq 1 60); do
        STATUS_JSON=$("$JUJU" status -m "$MODEL" --format json)
        app_exists {{ a.app }} || break
        sleep 5
      done
      if app_exists {{ a.app }}; then
        echo "REMOVE-FAILED {{ a.app }}: still in the model 5 minutes after removal" >&2
        exit 1
      fi
{% else %}
      echo "PLACEMENT-MISMATCH {{ a.app }}: currently on machine ${st#MOVE }, the topology wants {{ to }}. That application is not marked movable (it may hold local data); refusing to migrate it automatically." >&2
      exit 1
{% endif %}
      ;;
  esac
fi
{% endif %}
{% endfor %}

{% for a in apps %}
{%- set to = (pve_ussuri_unit_machines[a.app] | default({}) | dictsort | map('last') | join(',')) %}
{%- set units = a.num_units | default(0) | int %}
{%- set cfg = a.config | default({}) %}
if app_exists {{ a.app }}; then
  echo "SKIP {{ a.app }}"
else
  echo "DEPLOY {{ a.app }}"
  j deploy {{ a.charm }} {{ a.app }} --series focal --channel {{ a.channel }} --revision {{ a.revision }}{% if not (a.subordinate | default(false)) and units > 0 %} --num-units {{ units }}{% endif %}{% if not (a.subordinate | default(false)) and to %} --to '{{ to }}'{% endif %}{% for k, v in cfg | dictsort %} --config {{ (k ~ '=' ~ (v | string)) | quote }}{% endfor %}{% if a.bind | default('') %} --bind {{ a.bind | quote }}{% endif %} -m "$MODEL" 2>&1 | tail -3
fi
{% endfor %}

echo "--- settle {{ settle }}s before wiring relations ---"
sleep {{ settle }}

{% for pair in rels %}
j add-relation -m "$MODEL" {{ pair[0] | quote }} {{ pair[1] | quote }} 2>&1 | tail -3
{% endfor %}

echo DEPLOY-SCRIPT-DONE