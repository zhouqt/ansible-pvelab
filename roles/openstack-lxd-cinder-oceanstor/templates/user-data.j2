package_update: true
package_upgrade: false
packages:
  - openssh-server
  - open-iscsi
  - multipath-tools
  - tgt
  - lsscsi
  - sg3-utils
runcmd:
  - systemctl enable --now ssh
  - systemctl enable --now iscsid
write_files:
  - path: /etc/netplan/50-lxd.yaml
    permissions: '0644'
    content: |
      network:
        version: 2
        ethernets:
          enp5s0:
            dhcp4: false
            addresses:
              - {{ co_eth0_ip }}/24
            routes:
              - to: 192.168.165.0/24
                via: 192.168.165.1
          enp6s0:
            dhcp4: false
            addresses:
              - {{ co_eth1_ip }}/24
            routes:
              - to: 0.0.0.0/0
                via: 192.168.122.1
            nameservers:
              addresses: [192.168.122.1, 8.8.8.8]
ssh_authorized_keys:
  - {{ co_juju_ssh_pubkey | trim }}
