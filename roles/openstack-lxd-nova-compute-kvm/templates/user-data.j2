package_update: true
package_upgrade: false
packages:
  - openssh-server
  - open-iscsi
  - multipath-tools
  - qemu-kvm
  - libvirt-bin
  - lshw
  - dmidecode
  - lsscsi
  - sg3-utils
runcmd:
  - systemctl enable --now ssh
  - systemctl enable --now iscsid
write_files:
  - path: /etc/netplan/50-lxd.yaml
    permissions: '0644'
    content: |
      network:
        version: 2
        ethernets:
          enp5s0:
            dhcp4: false
          enp6s0:
            dhcp4: false
            addresses:
              - {{ nck_eth1_ip }}/24
            routes:
              - to: 192.168.165.0/24
                via: 192.168.165.1
        bridges:
          br-ex:
            addresses:
              - {{ nck_br_ex_ip }}/24
            interfaces:
              - enp5s0
            routes:
              - to: 0.0.0.0/0
                via: 192.168.122.1
              - to: 192.168.122.0/24
                via: 192.168.122.1
            nameservers:
              addresses: [192.168.122.1, 8.8.8.8]
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    permissions: '0644'
    content: |
      network: {config: disabled}
ssh_authorized_keys:
  - {{ nck_juju_ssh_pubkey | trim }}
