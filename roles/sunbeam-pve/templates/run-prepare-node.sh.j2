#!/bin/bash
set -uo pipefail

mode=${1:-}
log={{ sunbeam_node_log_dir }}/node-prepare.log
mkdir -p {{ sunbeam_node_log_dir }}

if [ "$mode" = "--bootstrap" ]; then
    su - {{ sunbeam_node_user }} -c 'sunbeam prepare-node-script --bootstrap | bash' >"$log" 2>&1
else
    su - {{ sunbeam_node_user }} -c 'sunbeam prepare-node-script | bash' >"$log" 2>&1
fi
rc=$?

echo "prepare-node-script rc=$rc (log: $log)"
tail -n 30 "$log"
exit "$rc"
