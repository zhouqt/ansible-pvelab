apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ pve_obs_cos_hub_lb_pool_name }}
  namespace: metallb-system
spec:
  addresses:
{% for address in pve_obs_cos_hub_lb_pool_addresses %}
    - {{ address }}
{% endfor %}
  autoAssign: true
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ pve_obs_cos_hub_lb_pool_name }}
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ pve_obs_cos_hub_lb_pool_name }}
