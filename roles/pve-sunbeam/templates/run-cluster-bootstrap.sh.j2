#!/bin/bash
set -uo pipefail

log={{ pve_sunbeam_node_log_dir }}/cluster-bootstrap.log
mkdir -p {{ pve_sunbeam_node_log_dir }}

su - {{ pve_sunbeam_node_user }} -c 'sunbeam cluster bootstrap \
    --accept-defaults \
    --role {{ pve_sunbeam_primary_node.role }} \
    --topology multi \
    --manifest {{ pve_sunbeam_manifest_path }}' >"$log" 2>&1
rc=$?

echo "cluster bootstrap rc=$rc (log: $log)"
tail -n 40 "$log"
exit "$rc"
