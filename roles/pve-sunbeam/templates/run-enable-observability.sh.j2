#!/bin/bash
set -uo pipefail

user={{ pve_sunbeam_node_user }}
log={{ pve_sunbeam_node_log_dir }}/observability-enable.log
mkdir -p {{ pve_sunbeam_node_log_dir }}

output="$(su - "$user" -c 'sunbeam enable observability external {{ pve_sunbeam_obs_controller }} {{ pve_sunbeam_obs_grafana_offer }} {{ pve_sunbeam_obs_prometheus_offer }} {{ pve_sunbeam_obs_loki_offer }}' 2>&1)"
rc=$?
printf '%s\n' "$output" | tee "$log"
echo "enable observability rc=$rc (log: $log)"
exit "$rc"
