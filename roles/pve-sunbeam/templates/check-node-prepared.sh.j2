#!/bin/bash
set -u

user={{ pve_sunbeam_node_user }}
home={{ pve_sunbeam_node_home }}
require_controller=no
[ "${1:-}" = "--require-controller" ] && require_controller=yes

ok=yes
id "$user" >/dev/null 2>&1 || ok=no
[ -f "$home/.ssh/id_ed25519" ] || ok=no
id -nG "$user" 2>/dev/null | grep -qw snap_daemon || ok=no

if [ "$ok" = yes ] && [ "$require_controller" = yes ]; then
    juju_out=$(su - "$user" -c 'juju controllers --format json' 2>/dev/null)
    juju_rc=$?
    verdict=$(printf '%s' "$juju_out" | python3 -c 'import json, sys
raw = sys.stdin.read()
start = raw.find("{")
if start < 0:
    print("2")
else:
    try:
        controllers = json.loads(raw[start:]).get("controllers")
    except Exception:
        print("2")
    else:
        print("0" if controllers else "1")' 2>/dev/null) || verdict=2
    [ -n "$verdict" ] || verdict=2
    case "$verdict" in
        0) ;;
        1) ok=no ;;
        *)
            echo "prepared=error (juju controllers unreadable: rc=$juju_rc)"
            printf '%s\n' "$juju_out" | tail -n 3
            exit 2
            ;;
    esac
fi

echo "prepared=$ok"
