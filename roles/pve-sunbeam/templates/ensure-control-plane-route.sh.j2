#!/bin/bash
set -u

nic=${1:?usage: <nic> <gateway>}
gateway=${2:?usage: <nic> <gateway>}
cidr={{ sunbeam_k8s_loadbalancer_cidr }}
api_host={{ sunbeam_control_plane_api_host }}
api_port={{ sunbeam_control_plane_api_port }}
dropin_name=50-sunbeam-control-plane.conf

netfile=""
for f in /etc/systemd/network/*.network; do
    [ -e "$f" ] || continue
    if awk -v want="$nic" '
            /^\[Match\]/ { inmatch = 1; next }
            /^\[/        { inmatch = 0 }
            inmatch && tolower($1) == "name" {
                v = $3
                if (v == want) { found = 1 }
                exit
            }
            END { exit(found ? 0 : 1) }
        ' "$f"; then
        netfile="$f"
        break
    fi
done

if [ -z "$netfile" ]; then
    echo "DROPIN=no-network-file nic=$nic"
    echo "ROUTE=missing"
    exit 0
fi
echo "NETFILE=$netfile"

dropin="${netfile}.d/${dropin_name}"
mkdir -p "${netfile}.d" || { echo "DROPIN=mkdir-failed"; echo "ROUTE=missing"; exit 0; }

desired=$(cat <<EOF
[Route]
Destination=${cidr}
Gateway=${gateway}
EOF
)

state=present
if [ ! -f "$dropin" ] || ! printf '%s\n' "$desired" | cmp -s - "$dropin"; then
    tmp="${dropin}.tmp.$$"
    printf '%s\n' "$desired" >"$tmp" && mv -f "$tmp" "$dropin" || {
        echo "DROPIN=write-failed"
        echo "ROUTE=missing"
        exit 0
    }
    state=written
    networkctl reload >/dev/null 2>&1 || true
    sleep 2
fi
echo "DROPIN=${state}"

if ip route get "$api_host" 2>/dev/null | grep -q "^${api_host} .*via ${gateway}"; then
    echo "ROUTE=ok"
else
    echo "ROUTE=missing"
    echo "ROUTE_LINE=$(ip route get "$api_host" 2>&1 | head -1)"
    exit 0
fi

api=$(curl -sk -m 10 -o /dev/null -w '%{http_code}' "https://${api_host}:${api_port}/" 2>/dev/null || true)
echo "API=${api:-none}"
exit 0
