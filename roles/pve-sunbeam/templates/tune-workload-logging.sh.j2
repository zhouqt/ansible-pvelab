#!/bin/bash
set -uo pipefail

{% set keep_files = pve_sunbeam_obs_logrotate_keep_files | int %}
{% set maxage_days = pve_sunbeam_obs_logrotate_maxage_days | int %}
{% set maxage_minutes = maxage_days * 1440 %}

{% set charm_patch %}
for f in /var/lib/juju/agents/unit-*/charm/src/relations/kubernetes_cos.py; do
    [ -f "$f" ] || continue
    if grep -q '/var/log/mysqlrouter/\*\*/\*log\*' "$f"; then
        sed -i 's#/var/log/mysqlrouter/\*\*/\*log\*#/var/log/mysqlrouter/mysqlrouter.log*#' "$f"
        echo "CHARM-SRC-PATCHED $f"
    else
        echo "CHARM-SRC-OK $f"
    fi
done
for e in /var/lib/juju/agents/unit-*/charm/scripts/logrotate_executor.py; do
    [ -f "$e" ] || continue
    if grep -q '3600' "$e" && ! grep -q '"-f"' "$e"; then
        echo "EXECUTOR-SRC-OK $e"
    else
        sed -i -e '/^[[:space:]]*"-f",$/d' \
               -e 's/60 - (time.time() % 60)/3600 - (time.time() % 3600)/' \
               -e 's/60\.0 - ((time.monotonic() - start_time) % 60\.0)/3600.0 - ((time.monotonic() - start_time) % 3600.0)/' \
               -e 's/every minute/every hour/' "$e"
        echo "EXECUTOR-SRC-PATCHED $e"
    fi
done
for t in /var/lib/juju/agents/unit-*/charm/venv/lib/python3*/site-packages/common/templates/logrotate.j2; do
    [ -f "$t" ] || continue
    if grep -qE '^rotate {{ keep_files }}$' "$t" && grep -qE '^maxage {{ maxage_days }}$' "$t" && grep -qE '^notifempty$' "$t"; then
        echo "TEMPLATE-OK $t"
    else
        sed -i -e 's/^rotate [0-9]\+$/rotate {{ keep_files }}/' \
               -e 's/^maxage [0-9]\+$/maxage {{ maxage_days }}/' \
               -e 's/^ifempty$/notifempty/' "$t"
        echo "TEMPLATE-PATCHED $t"
    fi
done
{% endset %}

{% set workload_patch %}
cfg=/etc/promtail/promtail_config.yaml
if [ -f "$cfg" ]; then
    if grep -q '/var/log/mysqlrouter/\*\*/\*log\*' "$cfg"; then
        sed -i 's#/var/log/mysqlrouter/\*\*/\*log\*#/var/log/mysqlrouter/mysqlrouter.log*#' "$cfg"
        echo "CONFIG-PATCHED $cfg"
    else
        echo "CONFIG-OK $cfg"
    fi
    : > /opt/promtail/positions.yaml
    echo "POSITIONS-RESET"
else
    echo "CONFIG-MISSING"
fi
policy=/etc/logrotate.d/flush_mysqlrouter_logs
if [ -f "$policy" ]; then
    if grep -qE '^rotate {{ keep_files }}$' "$policy" && grep -qE '^maxage {{ maxage_days }}$' "$policy" && grep -qE '^notifempty$' "$policy"; then
        echo "POLICY-OK $policy"
    else
        sed -i -e 's/^rotate [0-9]\+$/rotate {{ keep_files }}/' \
               -e 's/^maxage [0-9]\+$/maxage {{ maxage_days }}/' \
               -e 's/^ifempty$/notifempty/' "$policy"
        echo "POLICY-PATCHED $policy"
    fi
else
    echo "POLICY-MISSING"
fi
exe=/logrotate_executor.py
if [ -f "$exe" ]; then
    if grep -q '3600' "$exe" && ! grep -q '"-f"' "$exe"; then
        echo "EXECUTOR-OK $exe"
    else
        sed -i -e '/^[[:space:]]*"-f",$/d' \
               -e 's/60 - (time.time() % 60)/3600 - (time.time() % 3600)/' \
               -e 's/60\.0 - ((time.monotonic() - start_time) % 60\.0)/3600.0 - ((time.monotonic() - start_time) % 3600.0)/' \
               -e 's/every minute/every hour/' "$exe"
        echo "EXECUTOR-PATCHED $exe"
    fi
    if PEBBLE_SOCKET=/charm/container/pebble.socket /charm/bin/pebble restart logrotate_executor >/dev/null 2>&1; then
        echo "EXECUTOR-RESTARTED"
    else
        echo "EXECUTOR-RESTART-FAILED"
    fi
else
    echo "EXECUTOR-MISSING"
fi
d=/var/log/mysqlrouter/archive_mysqlrouter
if [ -d "$d" ]; then
    before=$(ls -1 "$d" 2>/dev/null | wc -l)
    if [ "$before" -gt {{ keep_files }} ]; then
        ls -1 "$d" 2>/dev/null | sort | head -n -{{ keep_files }} \
            | while IFS= read -r f; do rm -f "$d/$f"; done
    fi
    find "$d" -type f -mmin +{{ maxage_minutes }} -delete 2>/dev/null
    after=$(ls -1 "$d" 2>/dev/null | wc -l)
    if [ "$after" -lt "$before" ]; then
        echo "ARCHIVE-PRUNED before=${before} after=${after} keep={{ keep_files }}"
    else
        echo "ARCHIVE before=${before} after=${after} keep={{ keep_files }}"
    fi
else
    echo "ARCHIVE-MISSING"
fi
if PEBBLE_SOCKET=/charm/container/pebble.socket /charm/bin/pebble restart promtail >/dev/null 2>&1; then
    echo "PROMTAIL-RESTARTED"
else
    echo "PROMTAIL-RESTART-FAILED"
fi
{% endset %}

K8S="/snap/bin/k8s kubectl"
NS="openstack"

CHARM_PATCH_B64="{{ charm_patch | b64encode }}"
WORKLOAD_PATCH_B64="{{ workload_patch | b64encode }}"

echo "LOGGING-TUNE-START"

pods=$($K8S -n "$NS" get pods -o jsonpath='{range .items[*]}{.metadata.name}{" "}{range .spec.containers[*]}{.name}{" "}{end}{"\n"}{end}' 2>/dev/null)

if [ -z "${pods}" ]; then
    echo "LOGGING-TUNE-SKIP no pods found in namespace ${NS}"
    exit 0
fi

patched=0
already=0
pruned=0

while read -r pod containers; do
    [ -z "${pod}" ] && continue
    for container in ${containers}; do
        [ "${container}" = "charm" ] && continue
        [ "${container}" = "charm-init" ] && continue

        if ! $K8S -n "$NS" exec "${pod}" -c "${container}" -- \
                sh -c '[ -d /opt/promtail ]' >/dev/null 2>&1; then
            continue
        fi

        $K8S -n "$NS" exec "${pod}" -c "charm" -- \
            bash -c "echo ${CHARM_PATCH_B64} | base64 -d | bash" 2>&1 |
            grep -E 'CHARM-SRC-(PATCHED|OK)|TEMPLATE-(PATCHED|OK)|EXECUTOR-SRC-(PATCHED|OK)' || true

        out=$($K8S -n "$NS" exec "${pod}" -c "${container}" -- \
            bash -c "echo ${WORKLOAD_PATCH_B64} | base64 -d | bash" 2>&1)
        echo "${out}" | grep -E 'CONFIG-(PATCHED|OK|MISSING)|POLICY-(PATCHED|OK|MISSING)|PROMTAIL-(RESTARTED|RESTART-FAILED)|POSITIONS-RESET|ARCHIVE|EXECUTOR' || true

        if echo "${out}" | grep -q 'CONFIG-PATCHED'; then
            patched=$((patched + 1))
        else
            already=$((already + 1))
        fi
        if echo "${out}" | grep -q 'ARCHIVE-PRUNED'; then
            pruned=$((pruned + 1))
        fi
    done
done <<< "${pods}"

echo "LOGGING-TUNE-SUMMARY patched=${patched} already_narrow=${already} archive_pruned=${pruned}"
echo "LOGGING-TUNE-END"
