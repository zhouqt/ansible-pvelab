#!/bin/bash
set -uo pipefail

log={{ pve_sunbeam_node_log_dir }}/configure-deployment.log
mkdir -p {{ pve_sunbeam_node_log_dir }}

su - {{ pve_sunbeam_node_user }} -c 'sunbeam configure deployment \
    --accept-defaults \
    --manifest {{ pve_sunbeam_manifest_path }} \
    --openrc {{ pve_sunbeam_admin_openrc_path }}' >"$log" 2>&1
rc=$?

chown {{ pve_sunbeam_node_user }}:{{ pve_sunbeam_node_user }} {{ pve_sunbeam_admin_openrc_path }} 2>/dev/null || true
chmod 0600 {{ pve_sunbeam_admin_openrc_path }} 2>/dev/null || true

echo "configure deployment rc=$rc (log: $log)"
tail -n 40 "$log"
exit "$rc"
