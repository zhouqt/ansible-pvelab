#!/bin/bash
set -u

user={{ pve_sunbeam_node_user }}
hostname={{ pve_sunbeam_primary_node.hostname }}

out=$(su - "$user" -c 'sunbeam cluster list --format yaml' 2>&1)
rc=$?

if [ "$rc" -ne 0 ]; then
    case "$out" in
        *"Failed to login to Juju Controller"*|*"No cluster"*|*"not bootstrapped"*|*"does not exist"*|*"not found"*|*"Controller cannot be None"*)
            echo "bootstrapped=no"
            ;;
        *)
            echo "cluster-state=error rc=$rc (unrecognized error; NOT treated as 'not bootstrapped')"
            printf '%s\n' "$out" | tail -n 5
            exit 3
            ;;
    esac
elif [ -z "$out" ]; then
    echo "cluster-state=error empty output (rc=0); NOT treated as 'not bootstrapped'"
    exit 3
elif printf '%s' "$out" | grep -qw "$hostname"; then
    marker=$(curl -s --unix-socket /var/snap/openstack/common/state/control.socket \
        http://localhost/1.0/config/sunbeam_bootstrapped 2>/dev/null) || marker=""
    if [ -z "$marker" ]; then
        echo "bootstrapped=yes bootstrap_complete=unknown (control socket unreadable)"
        exit 3
    fi
    complete=$(printf '%s' "$marker" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("unknown")
    raise SystemExit(0)
if "not found" in str(data.get("error", "")).lower():
    print("no")
    raise SystemExit(0)
value = data.get("metadata")
print("yes" if str(value).strip().strip(chr(34)).lower() == "true" else "no")
' 2>/dev/null) || complete=unknown
    case "$complete" in
        yes|no) echo "bootstrapped=yes bootstrap_complete=$complete" ;;
        *) echo "bootstrapped=yes bootstrap_complete=unknown ($marker)"; exit 3 ;;
    esac
else
    echo "bootstrapped=no"
fi
