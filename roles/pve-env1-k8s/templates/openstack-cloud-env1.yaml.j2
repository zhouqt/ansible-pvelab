clouds:
  {{ pve_ussuri_k8s_cloud_name }}:
    type: openstack
    auth-types: [userpass]
    endpoint: {{ pve_ussuri_k8s_keystone_url }}
    regions:
      {{ pve_ussuri_k8s_region }}:
        endpoint: {{ pve_ussuri_k8s_keystone_url }}
    ca-certificates:
      - |
{{ lookup('file', pve_ussuri_k8s_vault_ca_file) | indent(8, true) }}
